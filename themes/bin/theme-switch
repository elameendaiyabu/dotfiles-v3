#!/usr/bin/env bash
# theme-switch — render one palette into every app and live-reload them.
#
#   theme-switch <name>        apply a theme (first wallpaper)
#   theme-switch --next|--prev cycle themes
#   theme-switch --wall next   cycle wallpapers inside the current theme
#   theme-switch --restore     re-apply the current theme (used at i3 start)
#   theme-switch --list | --current
#
# Palettes live in ~/.config/themes/<name>/palette.sh, generated files in
# ~/.config/themes/current/ — never edit those by hand.
set -euo pipefail

THEMES="$HOME/.config/themes"
CUR="$THEMES/current"
DEFAULT=tokyo-night
mkdir -p "$CUR"

list_themes() { for p in "$THEMES"/*/palette.sh; do basename "$(dirname "$p")"; done; }
current_theme() { cat "$CUR/name" 2>/dev/null || echo "$DEFAULT"; }
wallpapers_of() { find "$THEMES/$1/wallpapers" -maxdepth 1 -type f \( -name '*.jpg' -o -name '*.png' \) | sort; }

# write atomically so watchers (nvim) never read a half-written file
put() { local tmp; tmp=$(mktemp "$CUR/.tmp.XXXXXX"); cat >"$tmp"; mv -f "$tmp" "$CUR/$1"; }

cycle() { # $1 = +1 | -1
	local all cur i n
	mapfile -t all < <(list_themes)
	cur=$(current_theme); n=${#all[@]}
	for i in "${!all[@]}"; do [[ ${all[$i]} == "$cur" ]] && break; done
	echo "${all[$(((i + $1 + n) % n))]}"
}

# ─── renderers ────────────────────────────────────────────────────────────
render_i3() {
	put i3.conf <<EOF
# class                 border     bg         text       indicator  child_border
client.focused          $ACCENT $ACCENT $BG $ACCENT2 $ACCENT
client.focused_inactive $SEL $BG $FG_DIM $SEL $SEL
client.unfocused        $BG_DARK $BG_DARK $FG_DIM $BG_DARK $BG_DARK
client.urgent           $RED $RED $BG $RED $RED
client.placeholder      $BG $BG $FG $BG $BG
client.background       $BG
EOF
}

render_polybar() {
	put polybar.ini <<EOF
[colors]
background = #E6${BG#\#}
background-solid = $BG
surface = $SURFACE
sel = $SEL
foreground = $FG
fg-dim = $FG_DIM
muted = $MUTED
accent = $ACCENT
accent2 = $ACCENT2
red = $RED
orange = $ORANGE
yellow = $YELLOW
green = $GREEN
cyan = $CYAN
blue = $BLUE
magenta = $MAGENTA
EOF
}

render_rofi() {
	put rofi.rasi <<EOF
* {
    bg:        $BG;
    bg-trans:  ${BG}F0;
    bg-dark:   $BG_DARK;
    surface:   $SURFACE;
    sel:       $SEL;
    fg:        $FG;
    fg-dim:    $FG_DIM;
    muted:     $MUTED;
    accent:    $ACCENT;
    accent2:   $ACCENT2;
    red:       $RED;
}
EOF
}

render_kitty() {
	{
		cat <<EOF
foreground              $FG
background              $BG
selection_foreground    $FG
selection_background    $SEL
cursor                  $ACCENT
cursor_text_color       $BG
cursor_trail_color      $ACCENT
url_color               $ACCENT2
active_border_color     $ACCENT
inactive_border_color   $SEL
bell_border_color       $RED
tab_bar_background      $BG_DARK
tab_bar_margin_color    $BG_DARK
active_tab_foreground   $BG
active_tab_background   $ACCENT
inactive_tab_foreground $FG_DIM
inactive_tab_background $SURFACE
mark1_background        $ACCENT
mark1_foreground        $BG
EOF
		for i in "${!TERM_COLORS[@]}"; do echo "color$i ${TERM_COLORS[$i]}"; done
	} | put kitty.conf
}

render_ghostty() {
	{
		cat <<EOF
background = $BG
foreground = $FG
cursor-color = $ACCENT
cursor-text = $BG
selection-background = $SEL
selection-foreground = $FG
EOF
		for i in "${!TERM_COLORS[@]}"; do echo "palette = $i=${TERM_COLORS[$i]}"; done
	} | put ghostty
}

render_tmux() {
	put tmux.conf <<EOF
set -g status-style "bg=default,fg=$FG_DIM"
set -g status-left "#[fg=$BG,bg=$ACCENT,bold] 󰣇 #S #[bg=default] "
set -g status-left-length 30
set -g status-right "#[fg=$MUTED]#{?client_prefix,#[fg=$ACCENT2]󰘳 ,}#[fg=$FG_DIM] %H:%M "
set -g window-status-format "#[fg=$MUTED] #I #W "
set -g window-status-current-format "#[fg=$BG,bg=$ACCENT2,bold] #I #W "
set -g window-status-separator ""
set -g pane-border-style "fg=$SEL"
set -g pane-active-border-style "fg=$ACCENT"
set -g message-style "bg=$SURFACE,fg=$FG"
set -g message-command-style "bg=$SURFACE,fg=$ACCENT"
set -g mode-style "bg=$SEL,fg=$FG"
set -g popup-border-style "fg=$ACCENT"
set -g display-panes-active-colour "$ACCENT"
set -g display-panes-colour "$SEL"
set -g clock-mode-colour "$ACCENT"
EOF
}

render_dunst() {
	# dunst can't include files, so the whole dunstrc is rendered
	cat >"$HOME/.config/dunst/dunstrc" <<EOF
# Generated by ~/.config/themes/bin/theme-switch — edit the template there.
[global]
    monitor = 0
    follow = mouse
    width = (280, 400)
    height = (0, 260)
    origin = top-right
    offset = (14, 40)
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 4
    indicate_hidden = yes
    separator_height = 0
    gap_size = 8
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 2
    corner_radius = 12
    sort = yes
    idle_threshold = 120
    font = JetBrainsMono Nerd Font Propo 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = breeze-dark, breeze, Adwaita
    sticky_history = yes
    history_length = 30
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    highlight = $ACCENT

[urgency_low]
    background = "${BG}F2"
    foreground = "$FG_DIM"
    frame_color = "$SEL"
    timeout = 4

[urgency_normal]
    background = "${BG}F2"
    foreground = "$FG"
    frame_color = "$ACCENT"
    timeout = 6

[urgency_critical]
    background = "${BG}F2"
    foreground = "$FG"
    frame_color = "$RED"
    highlight = "$RED"
    timeout = 0
EOF
}

render_btop() {
	mkdir -p "$HOME/.config/btop/themes"
	cat >"$HOME/.config/btop/themes/system.theme" <<EOF
theme[main_bg]=""
theme[main_fg]="$FG"
theme[title]="$FG"
theme[hi_fg]="$ACCENT"
theme[selected_bg]="$SEL"
theme[selected_fg]="$FG"
theme[inactive_fg]="$MUTED"
theme[graph_text]="$FG_DIM"
theme[meter_bg]="$SEL"
theme[proc_misc]="$ACCENT2"
theme[cpu_box]="$SEL"
theme[mem_box]="$SEL"
theme[net_box]="$SEL"
theme[proc_box]="$SEL"
theme[div_line]="$SEL"
theme[temp_start]="$GREEN"
theme[temp_mid]="$YELLOW"
theme[temp_end]="$RED"
theme[cpu_start]="$ACCENT"
theme[cpu_mid]="$ACCENT2"
theme[cpu_end]="$RED"
theme[free_start]="$GREEN"
theme[free_mid]="$GREEN"
theme[free_end]="$CYAN"
theme[cached_start]="$BLUE"
theme[cached_mid]="$BLUE"
theme[cached_end]="$ACCENT"
theme[available_start]="$YELLOW"
theme[available_mid]="$ORANGE"
theme[available_end]="$ORANGE"
theme[used_start]="$MAGENTA"
theme[used_mid]="$ACCENT2"
theme[used_end]="$RED"
theme[download_start]="$ACCENT"
theme[download_mid]="$ACCENT2"
theme[download_end]="$MAGENTA"
theme[upload_start]="$GREEN"
theme[upload_mid]="$YELLOW"
theme[upload_end]="$ORANGE"
theme[process_start]="$ACCENT"
theme[process_mid]="$ACCENT2"
theme[process_end]="$RED"
EOF
	local conf="$HOME/.config/btop/btop.conf"
	[[ -f $conf ]] && sed -i --follow-symlinks \
		-e 's/^color_theme = .*/color_theme = "system"/' \
		-e 's/^theme_background = .*/theme_background = False/' "$conf"
}

render_nvim() {
	local b01=$SURFACE
	[[ $MODE == light ]] && b01=$BG_DARK
	put nvim.lua <<EOF
return {
	name = "$NAME",
	scheme = "$NVIM_SCHEME",
	background = "$MODE",
	palette = {
		base00 = "$BG", base01 = "$b01", base02 = "$SEL", base03 = "$MUTED",
		base04 = "$FG_DIM", base05 = "$FG", base06 = "$FG", base07 = "$FG",
		base08 = "$RED", base09 = "$ORANGE", base0A = "$YELLOW", base0B = "$GREEN",
		base0C = "$CYAN", base0D = "$BLUE", base0E = "$MAGENTA", base0F = "$ACCENT2",
	},
}
EOF
}

render_starship() {
	# swap the generated palette block in place; named colours used by the
	# prompt ("blue", "purple", ...) are overridden by the palette
	local conf="$HOME/.config/starship.toml" block
	[[ -f $conf ]] || return 0
	block=$(
		cat <<EOF
# >>> theme-switch palette >>>
palette = "system"

[palettes.system]
black = "$BG_DARK"
red = "$RED"
green = "$GREEN"
yellow = "$YELLOW"
blue = "$ACCENT"
purple = "$ACCENT2"
cyan = "$CYAN"
white = "$FG"
bright-black = "$MUTED"
# <<< theme-switch palette <<<
EOF
	)
	local real tmp
	real=$(readlink -f "$conf")
	tmp=$(mktemp)
	# palette must sit at top level, so the block goes first in the file
	{ echo "$block"; sed '/^# >>> theme-switch palette >>>/,/^# <<< theme-switch palette <<</d' "$real"; } >"$tmp"
	cat "$tmp" >"$real" && rm -f "$tmp"
}

render_shell() {
	put shell.sh <<EOF
# sourced from ~/.bashrc
export FZF_DEFAULT_OPTS="\${FZF_DEFAULT_OPTS:-} --color=bg+:$SURFACE,bg:-1,fg:$FG_DIM,fg+:$FG,hl:$ACCENT,hl+:$ACCENT2,info:$MUTED,marker:$GREEN,prompt:$ACCENT,spinner:$ACCENT2,pointer:$ACCENT,header:$ACCENT2,border:$SEL,gutter:-1"
EOF
	{
		echo "*.background: $BG"
		echo "*.foreground: $FG"
		echo "*.cursorColor: $ACCENT"
		for i in "${!TERM_COLORS[@]}"; do echo "*.color$i: ${TERM_COLORS[$i]}"; done
	} | put Xresources
}

render_gtk() {
	local dark=1 theme=Adwaita-dark scheme=prefer-dark
	[[ $MODE == light ]] && dark=0 theme=Adwaita scheme=prefer-light
	for v in gtk-3.0 gtk-4.0; do
		local f="$HOME/.config/$v/settings.ini"
		mkdir -p "$(dirname "$f")"
		[[ -f $f ]] || printf '[Settings]\n' >"$f"
		sed -i --follow-symlinks '/^gtk-application-prefer-dark-theme=/d;/^gtk-theme-name=/d' "$f"
		sed -i --follow-symlinks "/^\[Settings\]/a gtk-application-prefer-dark-theme=$dark\ngtk-theme-name=$theme" "$f"
	done
	if command -v gsettings >/dev/null; then
		gsettings set org.gnome.desktop.interface color-scheme "$scheme" 2>/dev/null || true
		gsettings set org.gnome.desktop.interface gtk-theme "$theme" 2>/dev/null || true
	fi
}

# lock image + picker preview are slow-ish, so they're cached per wallpaper
render_images() {
	local wall=$1 key cache="$HOME/.cache/theme-switch"
	mkdir -p "$cache"
	key=$(basename "$(dirname "$(dirname "$wall")")")-$(basename "${wall%.*}")
	if [[ ! -f $cache/$key-lock.png ]]; then
		magick "$wall" -resize 2560x1440^ -gravity center -extent 2560x1440 \
			-scale 12% -blur 0x3 -resize 2560x1440! \
			-fill "$BG" -colorize 45% "$cache/$key-lock.png"
	fi
	ln -sfn "$cache/$key-lock.png" "$CUR/lock.png"
}

render_preview() { # $1 = theme
	local p="$THEMES/$1/preview.png" w sw=()
	[[ -f $p ]] && return 0
	w=$(wallpapers_of "$1" | head -1)
	for c in "$BG" "$SURFACE" "$ACCENT" "$ACCENT2" "$RED" "$YELLOW" "$GREEN" "$BLUE" "$MAGENTA" "$FG"; do
		sw+=("xc:$c")
	done
	magick \( "$w" -resize 480x270^ -gravity center -extent 480x270 \) \
		\( -size 48x22 "${sw[@]}" +append \) -append "$p"
}

# ─── live reloads ─────────────────────────────────────────────────────────
reload_all() {
	local wall=$1
	feh --no-fehbg --bg-fill "$wall" &
	xrdb -merge "$CUR/Xresources" 2>/dev/null || true
	i3-msg -q reload 2>/dev/null || true

	if pgrep -u "$UID" -x polybar >/dev/null; then
		polybar-msg cmd restart >/dev/null 2>&1 || true
	else
		setsid -f polybar main >/dev/null 2>&1
	fi

	pkill -USR1 -x kitty 2>/dev/null || true          # kitty: reload config
	pkill -USR2 -x ghostty 2>/dev/null || true        # ghostty: reload config
	if tmux info >/dev/null 2>&1; then tmux source-file "$HOME/.config/tmux/tmux.conf" 2>/dev/null || true; fi
	if pgrep -u "$UID" -x dunst >/dev/null; then dunstctl reload 2>/dev/null || true; fi
	pkill -USR2 -x btop 2>/dev/null || true           # btop: reload config
	# neovim watches ~/.config/themes/current/nvim.lua by itself
	wait
}

apply() {
	local name=$1 keep_wall=${2:-} wall=""
	[[ -f $THEMES/$name/palette.sh ]] || { echo "theme-switch: unknown theme '$name'" >&2; list_themes >&2; exit 1; }
	NAME=$name
	# shellcheck source=/dev/null
	source "$THEMES/$name/palette.sh"

	if [[ -n $keep_wall && -f $CUR/wallpaper ]]; then
		wall=$(cat "$CUR/wallpaper")
		[[ $wall == "$THEMES/$name/"* && -f $wall ]] || wall=""
	fi
	[[ -n $wall ]] || wall=$(wallpapers_of "$name" | head -1)

	echo "$name" | put name
	echo "$wall" | put wallpaper

	render_i3; render_polybar; render_rofi; render_kitty; render_ghostty
	render_tmux; render_dunst; render_btop; render_nvim; render_starship
	render_shell; render_gtk
	render_images "$wall"
	render_preview "$name"
	reload_all "$wall"
}

case "${1:-}" in
--list) list_themes ;;
--current) current_theme ;;
--next) apply "$(cycle 1)" ;;
--prev) apply "$(cycle -1)" ;;
--restore) apply "$(current_theme)" keep ;;
--previews) for t in $(list_themes); do (NAME=$t; source "$THEMES/$t/palette.sh"; render_preview "$t"); done ;;
--wall)
	name=$(current_theme)
	mapfile -t walls < <(wallpapers_of "$name")
	cur=$(cat "$CUR/wallpaper" 2>/dev/null || true)
	i=0
	for j in "${!walls[@]}"; do [[ ${walls[$j]} == "$cur" ]] && i=$j; done
	step=1; [[ ${2:-next} == prev ]] && step=-1
	next=${walls[$(((i + step + ${#walls[@]}) % ${#walls[@]}))]}
	NAME=$name; source "$THEMES/$name/palette.sh"
	echo "$next" | put wallpaper
	feh --no-fehbg --bg-fill "$next"
	render_images "$next"
	;;
"" | -h | --help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
*)
	apply "$1"
	command -v notify-send >/dev/null && notify-send -a theme-switch -i "$THEMES/$1/preview.png" \
		"Theme" "Switched to <b>$LABEL</b>" || true
	;;
esac
