configuration {
    modi:                 "drun,run,window";
    dpi:                  1;
    show-icons:           true;
    icon-theme:           "breeze-dark";
    display-drun:         "󰀻 ";
    display-run:          " ";
    display-window:       "󰖯 ";
    drun-display-format:  "{name}";
    window-format:        "{c}  {t}";
    matching:             "fuzzy";
    sort:                 true;
    sorting-method:       "fzf";
    disable-history:      false;
    hover-select:         true;
    me-select-entry:      "";
    me-accept-entry:      "MousePrimary";
}

@theme "~/.config/rofi/system.rasi"
