# Generated by ~/.config/themes/bin/theme-switch — edit the template there.
[global]
    monitor = 0
    follow = mouse
    width = (280, 400)
    height = (0, 260)
    origin = top-right
    offset = (14, 40)
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 4
    indicate_hidden = yes
    separator_height = 0
    gap_size = 8
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 2
    corner_radius = 12
    sort = yes
    idle_threshold = 120
    font = JetBrainsMono Nerd Font Propo 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = breeze-dark, breeze, Adwaita
    sticky_history = yes
    history_length = 30
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    highlight = #b3e6db

[urgency_low]
    background = "#232a2eF2"
    foreground = "#839e9a"
    frame_color = "#3d494d"
    timeout = 4

[urgency_normal]
    background = "#232a2eF2"
    foreground = "#adc9bc"
    frame_color = "#b3e6db"
    timeout = 6

[urgency_critical]
    background = "#232a2eF2"
    foreground = "#adc9bc"
    frame_color = "#f57f82"
    highlight = "#f57f82"
    timeout = 0
